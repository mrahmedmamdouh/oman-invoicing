REACT_APP_API_URL=http://localhost:3001/api

# App Configuration
REACT_APP_APP_NAME=Oman Invoicing System
REACT_APP_APP_NAME_AR=نظام الفوترة العُماني
REACT_APP_VERSION=1.0.0

# Company Information
REACT_APP_COMPANY_NAME=Your Company Name
REACT_APP_COMPANY_NAME_AR=اسم شركتك
REACT_APP_SUPPORT_EMAIL=support@yourcompany.om
REACT_APP_SUPPORT_PHONE=+968-24-123456

# Feature Flags
REACT_APP_ENABLE_PEPPOL=true
REACT_APP_ENABLE_DIGITAL_SIGNATURE=true
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_DARK_MODE=false

# External Services
REACT_APP_OTA_ENVIRONMENT=sandbox
REACT_APP_OTA_API_URL=https://api.taxoman.gov.om

# Default Settings
REACT_APP_DEFAULT_LANGUAGE=ar
REACT_APP_DEFAULT_CURRENCY=OMR
REACT_APP_DEFAULT_TAX_RATE=0.05

# UI Configuration
REACT_APP_ITEMS_PER_PAGE=10
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_SUPPORTED_FORMATS=pdf,png,jpg,jpeg

# Development
GENERATE_SOURCEMAP=true
REACT_APP_DEBUG=false
